{
  "name": "tracker-tka",
  "version": "1.0.0",
  "description": "Progress Tracker TKA 20 Hari",
  "main": "main.js",
  "author": "Eggy",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.eggy.trackertka",
    "productName": "Tracker TKA",
    "files": [
      "main.js",
      "index.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "icon": "icon.png"
  }
}